@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #0b3c5d
skinparam classHeaderBackgroundColor #e6f0f7
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
left to right direction
title Camadas controller -> BO -> DAO
package "controller" {
class AbrigoController {
+listar(idBairro) : ResponseEntity<List<Abrigo>>
+buscar(id) : ResponseEntity<Abrigo>
+criar(corpo) : ResponseEntity<Abrigo>
+atualizar(id, corpo) : ResponseEntity<Abrigo>
+excluir(id) : ResponseEntity<Void>
}
class AlertaController {
+listar(ativos) : ResponseEntity<List<Alerta>>
+buscar(id) : ResponseEntity<Alerta>
+criar(corpo) : ResponseEntity<Alerta>
+atualizar(id, corpo) : ResponseEntity<Alerta>
+encerrar(id) : ResponseEntity<Alerta>
+excluir(id) : ResponseEntity<Void>
}
class BairroController {
+listar() : ResponseEntity<List<Bairro>>
+buscar(id) : ResponseEntity<Bairro>
+criar(corpo) : ResponseEntity<Bairro>
+atualizar(id, corpo) : ResponseEntity<Bairro>
+excluir(id) : ResponseEntity<Void>
}
class CidadaoController {
+listar() : ResponseEntity<List<Cidadao>>
+buscar(id) : ResponseEntity<Cidadao>
+criar(corpo) : ResponseEntity<Cidadao>
+atualizar(id, corpo) : ResponseEntity<Cidadao>
+excluir(id) : ResponseEntity<Void>
}
class InfoController {
+info() : ResponseEntity<Map<String, Object>>
}
class LeituraController {
+listar(idSensor) : ResponseEntity<List<Leitura>>
+buscar(id) : ResponseEntity<Leitura>
+registrar(corpo) : ResponseEntity<LeituraRegistradaResponse>
+atualizar(id, corpo) : ResponseEntity<Leitura>
+excluir(id) : ResponseEntity<Void>
}
class NotificacaoController {
+listar(idCidadao, idAlerta) : ResponseEntity<List<Notificacao>>
+buscar(id) : ResponseEntity<Notificacao>
+criar(corpo) : ResponseEntity<Notificacao>
+atualizar(id, corpo) : ResponseEntity<Notificacao>
+marcarComoLida(id) : ResponseEntity<Notificacao>
+excluir(id) : ResponseEntity<Void>
}
class OcorrenciaController {
+listar(status, idPonto) : ResponseEntity<List<Ocorrencia>>
+buscar(id) : ResponseEntity<Ocorrencia>
+criar(corpo) : ResponseEntity<Ocorrencia>
+atualizar(id, corpo) : ResponseEntity<Ocorrencia>
