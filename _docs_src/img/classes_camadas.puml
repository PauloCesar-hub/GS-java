}
class PontoRiscoController {
+listar(idBairro) : ResponseEntity<List<PontoRisco>>
+situacaoGeral() : ResponseEntity<List<SituacaoPontoResponse>>
+buscar(id) : ResponseEntity<PontoRisco>
+situacao(id) : ResponseEntity<SituacaoPontoResponse>
+criar(corpo) : ResponseEntity<PontoRisco>
+atualizar(id, corpo) : ResponseEntity<PontoRisco>
+excluir(id) : ResponseEntity<Void>
}
class SensorController {
+listar(idPonto) : ResponseEntity<List<Sensor>>
+buscar(id) : ResponseEntity<Sensor>
+criar(corpo) : ResponseEntity<Sensor>
+atualizar(id, corpo) : ResponseEntity<Sensor>
+excluir(id) : ResponseEntity<Void>
}
}
package "bo" {
class AbrigoBO {
+listar(idBairro) : List<Abrigo>
+buscar(id) : Abrigo
+criar(abrigo) : Abrigo
+atualizar(id, abrigo) : Abrigo
+excluir(id) : void
}
class AlertaBO {
+listar(somenteAtivos) : List<Alerta>
+buscar(id) : Alerta
+criar(alerta) : Alerta
+atualizar(id, alerta) : Alerta
+encerrar(id) : Alerta
+excluir(id) : void
+avaliarNivel(ponto, alturaCm, quando) : AvaliacaoNivelResponse
}
class BairroBO {
+listar() : List<Bairro>
+buscar(id) : Bairro
+criar(bairro) : Bairro
+atualizar(id, bairro) : Bairro
+excluir(id) : void
}
class CidadaoBO {
+listar() : List<Cidadao>
+buscar(id) : Cidadao
+criar(cidadao) : Cidadao
+atualizar(id, cidadao) : Cidadao
+excluir(id) : void
}
class LeituraBO {
+listar(idSensor) : List<Leitura>
+buscar(id) : Leitura
+registrar(leitura) : LeituraRegistradaResponse
+atualizar(id, leitura) : Leitura
+excluir(id) : void
}
class NotificacaoBO {
+listar(idCidadao, idAlerta) : List<Notificacao>
+buscar(id) : Notificacao
+criar(n) : Notificacao
+atualizar(id, n) : Notificacao
+marcarComoLida(id) : Notificacao
+excluir(id) : void
}
class OcorrenciaBO {
+listar(status, idPonto) : List<Ocorrencia>
+buscar(id) : Ocorrencia
+criar(ocorrencia) : Ocorrencia
+atualizar(id, ocorrencia) : Ocorrencia
+alterarStatus(id, novoStatus) : Ocorrencia
