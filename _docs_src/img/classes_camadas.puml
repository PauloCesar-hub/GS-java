}
class PontoRiscoBO {
+listar(idBairro) : List<PontoRisco>
+buscar(id) : PontoRisco
+criar(ponto) : PontoRisco
+atualizar(id, ponto) : PontoRisco
+excluir(id) : void
+situacaoGeral() : List<SituacaoPontoResponse>
+situacao(id) : SituacaoPontoResponse
}
class SensorBO {
+listar(idPonto) : List<Sensor>
+buscar(id) : Sensor
+criar(sensor) : Sensor
+atualizar(id, sensor) : Sensor
+excluir(id) : void
}
}
package "dao" {
class AbrigoDao {
+listar() : List<Abrigo>
+listarPorBairro(idBairro) : List<Abrigo>
+buscarPorId(id) : Optional<Abrigo>
+inserir(a) : Abrigo
+atualizar(a) : boolean
+excluir(id) : boolean
}
class AlertaDao {
+listar() : List<Alerta>
+listarAtivos() : List<Alerta>
+listarAtivosPorPonto(idPonto) : List<Alerta>
+buscarPorId(id) : Optional<Alerta>
+inserir(a) : Alerta
+atualizar(a) : boolean
+encerrarAtivosDoPonto(idPonto, quando) : int
+excluir(id) : boolean
}
class BairroDao {
+listar() : List<Bairro>
+buscarPorId(id) : Optional<Bairro>
+inserir(b) : Bairro
+atualizar(b) : boolean
+excluir(id) : boolean
}
abstract class BaseDao {
-dataSource : DataSource
#listar(sql, parametros, mapeador) : List<T>
#buscarUm(sql, parametros, mapeador) : Optional<T>
#inserir(sql, colunaId, parametros) : long
#executar(sql, parametros) : int
#traduzir(SQLException) : RuntimeException
}
class CidadaoDao {
+listar() : List<Cidadao>
+buscarPorId(id) : Optional<Cidadao>
+buscarPorEmail(email) : Optional<Cidadao>
+listarQueRecebemAlerta(idBairro) : List<Cidadao>
+inserir(c) : Cidadao
+atualizar(c) : boolean
+excluir(id) : boolean
}
class LeituraDao {
+listar() : List<Leitura>
+listarPorSensor(idSensor) : List<Leitura>
+buscarPorId(id) : Optional<Leitura>
+ultimaLeituraDeNivel(idPonto) : Optional<Leitura>
+inserir(l) : Leitura
+atualizar(l) : boolean
+excluir(id) : boolean
}
class NotificacaoDao {
+listar() : List<Notificacao>
+listarPorCidadao(idCidadao) : List<Notificacao>
+listarPorAlerta(idAlerta) : List<Notificacao>
+buscarPorId(id) : Optional<Notificacao>
+existe(idAlerta, idCidadao) : boolean
+inserir(n) : Notificacao
+atualizar(n) : boolean
+excluir(id) : boolean
}
class OcorrenciaDao {
+listar() : List<Ocorrencia>
+listarPorStatus(status) : List<Ocorrencia>
+listarPorPonto(idPonto) : List<Ocorrencia>
+buscarPorId(id) : Optional<Ocorrencia>
+inserir(o) : Ocorrencia
+atualizar(o) : boolean
+excluir(id) : boolean
}
class PontoRiscoDao {
+listar() : List<PontoRisco>
+listarAtivos() : List<PontoRisco>
+listarPorBairro(idBairro) : List<PontoRisco>
+buscarPorId(id) : Optional<PontoRisco>
+inserir(p) : PontoRisco
+atualizar(p) : boolean
+excluir(id) : boolean
}
class SensorDao {
+listar() : List<Sensor>
+listarPorPonto(idPonto) : List<Sensor>
+buscarPorId(id) : Optional<Sensor>
+buscarPorCodigoSerie(codigo) : Optional<Sensor>
+inserir(s) : Sensor
+atualizar(s) : boolean
+excluir(id) : boolean
}
}
